<?xml version="1.0" encoding="UTF-8"?>
<!--
Label catalog for the stylesheets: UI strings rendered by Web-Client's own templates,
looked up as key('resources', 'https://w3id.org/atomgraph/client/xsl/translations.rdf#$id', ac:translations()) and emitted via the
ac:label mode. Entries are URI resources (not blank nodes) so the identifiers survive the graph
repository's parse/serialize round-trip. Downstream layers keep their own catalogs for their own templates.
-->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="https://w3id.org/atomgraph/client/xsl/translations.rdf">
    <rdf:Description rdf:about="#literal">
        <rdfs:label xml:lang="en-US">Literal</rdfs:label>
        <rdfs:label xml:lang="es-ES">Literal</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="#resource">
        <rdfs:label xml:lang="en-US">Resource</rdfs:label>
        <rdfs:label xml:lang="es-ES">Recurso</rdfs:label>
    </rdf:Description>
