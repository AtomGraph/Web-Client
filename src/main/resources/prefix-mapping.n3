@prefix lm: <http://jena.hpl.hp.com/2004/08/location-mapping#> .

[] lm:mapping

   # this project's own vocabulary, also dereferenced directly by the stylesheets
   [ lm:prefix "https://w3id.org/atomgraph/client" ;                        lm:altName "com/atomgraph/client/ns.ttl" ] ,

   # vocabularies with a dedicated stylesheet module
   [ lm:prefix "http://www.w3.org/1999/02/22-rdf-syntax-ns" ;               lm:altName "com/atomgraph/client/rdf.ttl" ] ,
   [ lm:prefix "http://www.w3.org/2000/01/rdf-schema" ;                     lm:altName "com/atomgraph/client/rdfs.owl" ] ,
   [ lm:prefix "http://purl.org/dc/terms/" ;                                lm:altName "com/atomgraph/client/dcterms.rdf" ] ,
   [ lm:prefix "http://purl.org/dc/elements/1.1/" ;                         lm:altName "com/atomgraph/client/dcelements.rdf" ] ,
   [ lm:prefix "http://xmlns.com/foaf/0.1/" ;                               lm:altName "com/atomgraph/client/foaf.owl" ] ,
   [ lm:prefix "http://rdfs.org/sioc/ns" ;                                  lm:altName "com/atomgraph/client/sioc.owl" ] ,
   [ lm:prefix "http://www.w3.org/2004/02/skos/core" ;                      lm:altName "com/atomgraph/client/skos.owl" ] ,
   [ lm:prefix "http://usefulinc.com/ns/doap" ;                             lm:altName "com/atomgraph/client/doap.owl" ] ,
   [ lm:prefix "http://www.w3.org/ns/sparql-service-description" ;          lm:altName "com/atomgraph/client/sparql-service.owl" ]
.
