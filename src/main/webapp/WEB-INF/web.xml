<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
    version="5.0"
    id="atomgraph-client">
    <display-name>AtomGraph Client</display-name>
    <description>Generic Linked Data client</description>
    <context-param>
        <param-name>https://w3id.org/atomgraph/client#stylesheet</param-name>
        <param-value>static/com/atomgraph/client/xsl/external-layout.xsl</param-value>
    </context-param>
    <context-param>
        <param-name>https://w3id.org/atomgraph/core#resultLimit</param-name>
        <param-value>100</param-value>
    </context-param>
    <context-param>
        <param-name>https://w3id.org/atomgraph/client#prefixMapping</param-name>
        <param-value>prefix-mapping.n3</param-value>
    </context-param>
    <context-param>
        <param-name>https://w3id.org/atomgraph/client#cacheStylesheet</param-name>
        <param-value>true</param-value>
    </context-param>
    <context-param>
        <param-name>https://w3id.org/atomgraph/client#resolvingUncached</param-name>
        <param-value>false</param-value>
    </context-param>
    <servlet>
        <servlet-name>com.atomgraph.client.Application</servlet-name>
    </servlet>
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/static/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>com.atomgraph.client.Application</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
    <listener>
        <listener-class>com.atomgraph.core.util.jena.StartupListener</listener-class>
    </listener>
    <!-- The text types this app serves from /static carry UTF-8: em dashes and middots in the kit
         stylesheets' comments, a ⤴ in a content: value, translated labels in the XSL. Tomcat's default
         mappings name no charset, so a direct fetch decodes them with the client's fallback encoding -
         windows-1252 in a browser tab - and every multi-byte character breaks apart. A stylesheet or
         script loaded from a page escapes this by inheriting the referencing document's encoding, which
         is why pages rendered correctly while the files did not. An app that overlays this WAR supplies
         its own web.xml and so needs the same block; these are the mappings for a standalone deploy. -->
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>js</extension>
        <mime-type>text/javascript;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>txt</extension>
        <mime-type>text/plain;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>xsl</extension>
        <mime-type>text/xsl;charset=UTF-8</mime-type>
    </mime-mapping>
</web-app>
