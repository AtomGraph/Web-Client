    </rdf:Description>
    <rdf:Description rdf:nodeID="developed-by">
        <rdfs:label xml:lang="en-US">Developed by</rdfs:label>
        <rdfs:label xml:lang="es-ES">Desarrollado por</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="apache-license">
        <rdfs:label xml:lang="en-US">Apache License</rdfs:label>
