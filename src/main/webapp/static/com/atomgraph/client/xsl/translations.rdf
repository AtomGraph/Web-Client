    <rdf:Description rdf:nodeID="rdf-xml">
        <rdfs:label xml:lang="en-US">RDF/XML</rdfs:label>
        <rdfs:label xml:lang="es-ES">RDF/XML</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="turtle">
        <rdfs:label xml:lang="en-US">Turtle</rdfs:label>
        <rdfs:label xml:lang="es-ES">Turtle</rdfs:label>
    </rdf:Description>
</rdf:RDF>
